<Window x:Class="TcpRedirectorGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TcpRedirectorGUI.Adapters.Driving.Wpf.ViewModels"
        xmlns:ctl="clr-namespace:TcpRedirectorGUI.Adapters.Driving.Wpf.Controls"
        Title="TcpRedirector"
        Height="900" Width="1100" MinHeight="700" MinWidth="900"
        Background="#1E1E1E"
        FontFamily="Segoe UI"
        TextElement.Foreground="#CCCCCC"
        WindowStartupLocation="CenterScreen">


    <Grid>
        <Grid.RowDefinitions>
            <!-- Service bar -->
            <RowDefinition Height="40"/>
            <!-- Content: single Viewbox — no scrollbars, everything scales together -->
            <RowDefinition Height="*"/>
            <!-- Status bar -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ============================================
             SERVICE CONTROL BAR
             ============================================ -->
        <Border Grid.Row="0" Background="#2D2D2D" BorderBrush="#3C3C3C"
                BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- v1.1.0: Connect button (GUI is IPC client only) -->
                <Button Grid.Column="0" Content="Connect"
                        Command="{Binding ConnectToServiceCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="16,6" Margin="0,0,6,0"/>

                <!-- Capture control buttons (visible only when connected) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsServiceAvailable, Converter={StaticResource BoolToVis}}">
                    <Button Content="▶ Start"
                            Command="{Binding StartCaptureCommand}"
                            Padding="10,6" Margin="0,0,2,0" FontSize="11">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCaptureRunning}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="⏹ Stop"
                            Command="{Binding StopCaptureCommand}"
                            Padding="10,6" Margin="0,0,2,0" FontSize="11">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCaptureRunning}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="↻ Reload"
                            Command="{Binding ReloadConfigCommand}"
                            Padding="10,6" Margin="0,0,6,0" FontSize="11"/>
                    <TextBlock Text="{Binding CaptureMsg, Mode=OneWay}"
                               Foreground="#4EC9B0" FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status indicator -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding IsConnected, Converter={StaticResource BoolToColor}}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding ServiceStatusText, Mode=OneWay}"
                               Foreground="#CCCCCC" FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SvcMsg, Mode=OneWay}"
                               Foreground="#4EC9B0" FontSize="12"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ============================================
             CONTENT: single Viewbox wrapping both
             settings + statistics, no scrollbars
             ============================================ -->
        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both">
            <Grid Width="1060" Height="720">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.60*"/>
                    <RowDefinition Height="0.40*"/>
                </Grid.RowDefinitions>

                <!-- SETTINGS (compact) -->
                <StackPanel Grid.Row="0">

                    <!-- Unified Save bar (compact) -->
                    <Border Background="#2D2D2D" BorderBrush="#3C3C3C"
                            BorderThickness="1" Padding="6,4" Margin="0,0,0,4"
                            CornerRadius="3">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="💾 Save All Settings"
                                    Command="{Binding Settings.SaveCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="12,4" FontSize="12" FontWeight="Bold"
                                    IsEnabled="{Binding IsServiceAvailable}"/>
                            <TextBlock Text="{Binding Settings.Msg, Mode=OneWay}"
                                       Foreground="#4EC9B0" FontWeight="Bold"
                                       FontSize="12" VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Proxy Settings (compact) -->
                    <TextBlock Text="PROXY SETTINGS" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource SectionBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Host:"
                                       VerticalAlignment="Center" Margin="0,1" FontSize="11"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding Settings.Host, Mode=TwoWay}"
                                     Margin="0,1" FontSize="11"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Port:"
                                       VerticalAlignment="Center" Margin="6,1,0,1" FontSize="11"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding Settings.Port, Mode=TwoWay}"
                                     Margin="6,1,0,1" FontSize="11"/>

                            <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                      Content="Authentication required"
                                      IsChecked="{Binding Settings.AuthRequired, Mode=TwoWay}"
                                      Margin="0,1" FontSize="11"/>
                        </Grid>
                    </Border>

                    <!-- Authentication (compact) -->
                    <TextBlock Text="AUTHENTICATION" Style="{StaticResource SectionHeader}"
                               Visibility="{Binding Settings.AuthRequired, Converter={StaticResource BoolToVis}}"/>
                    <Border Style="{StaticResource SectionBorder}"
                            Visibility="{Binding Settings.AuthRequired, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Login:"
                                       VerticalAlignment="Center" Margin="0,1" FontSize="11"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding Settings.Login, Mode=TwoWay}"
                                     Margin="0,1" FontSize="11"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Password:"
                                       VerticalAlignment="Center" Margin="6,1,0,1" FontSize="11"/>
                            <PasswordBox Grid.Row="0" Grid.Column="3"
                                         x:Name="PwdBox" Margin="6,1,0,1" FontSize="11"/>

                            <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                      Content="Use Kerberos protocol"
                                      IsChecked="{Binding Settings.KerberosEnabled, Mode=TwoWay}"
                                      Margin="0,1" FontSize="11"/>
                        </Grid>
                    </Border>

                    <!-- Rules (compact) -->
                    <TextBlock Text="RULES" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource SectionBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                                <Button Content="+ Add Rule"
                                        Command="{Binding Settings.AddRuleCommand}"
                                        Padding="8,3" Margin="0,0,6,0" FontSize="11"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Settings.Rules}"
                                      SelectedItem="{Binding Settings.SelectedRule}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      FontSize="11"
                                      MinHeight="40" MaxHeight="140"
                                      RowHeight="20">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="App" Binding="{Binding Description}" Width="130" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕"
                                                        Command="{Binding DataContext.Settings.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#5A1D1D" Foreground="#F44747"
                                                        BorderThickness="0" FontSize="10" Padding="4,2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="2" Foreground="#858585" Margin="0,2,0,0" FontSize="10">
                                Total: <Run Text="{Binding Settings.Rules.Count, Mode=OneWay}" FontWeight="Bold"/> rules
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Log Level (compact) -->
                    <TextBlock Text="LOG LEVEL" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource SectionBorder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Level:" Foreground="#858585"
                                       FontSize="11" VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <ComboBox SelectedIndex="{Binding Settings.LogLevelFilter, Mode=TwoWay}"
                                      Width="80" FontSize="11">
                                <ComboBoxItem Content="TRACE+"/>
                                <ComboBoxItem Content="DEBUG+"/>
                                <ComboBoxItem Content="INFO+"/>
                                <ComboBoxItem Content="WARN+"/>
                                <ComboBoxItem Content="ERROR+"/>
                            </ComboBox>
                            <TextBlock Text="{Binding Settings.LogMsg, Mode=OneWay}"
                                       Foreground="#858585"
                                       FontSize="10" VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- STATISTICS (bottom 1/3) -->
                <Grid Grid.Row="1" Background="#1E1E1E">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Graph header -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="TRAFFIC (bytes/sec)" FontWeight="Bold"
                                       Foreground="#DCDCAA" FontSize="13"/>
                        </Grid>

                        <!-- The custom chart control -->
                        <ctl:TrafficGraph Grid.Row="1"
                                          RxData="{Binding Stats.RxPoints}"
                                          TxData="{Binding Stats.TxPoints}"
                                          WindowSeconds="{Binding Stats.GraphWindowSec}"/>

                        <!-- Stats summary row 1 -->
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="#858585" FontSize="12">
                                <Run Text="Active connections:"/>
                                <Run Text="{Binding Stats.ActiveConnections, Mode=OneWay}" FontWeight="Bold" Foreground="#CCCCCC"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Foreground="#858585" FontSize="12" Margin="16,0">
                                <Run Text="RX:"/>
                                <Run Text="{Binding Stats.TotalRx, Mode=OneWay}" FontWeight="Bold" Foreground="#4EC9B0"/>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Foreground="#858585" FontSize="12">
                                <Run Text="TX:"/>
                                <Run Text="{Binding Stats.TotalTx, Mode=OneWay}" FontWeight="Bold" Foreground="#CE9178"/>
                            </TextBlock>
                        </Grid>

                        <!-- Stats summary row 2: derived metrics -->
                        <Grid Grid.Row="3" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="#858585" FontSize="12">
                                <Run Text="Proxy errors:"/>
                                <Run Text="{Binding Stats.ProxyErrors, Mode=OneWay}" FontWeight="Bold" Foreground="#F44747"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Foreground="#858585" FontSize="12" Margin="16,0">
                                <Run Text="Avg latency:"/>
                                <Run Text="{Binding Stats.AvgLatency, Mode=OneWay}" FontWeight="Bold" Foreground="#CCCCCC"/>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Foreground="#858585" FontSize="12" Margin="16,0">
                                <Run Text="Uptime:"/>
                                <Run Text="{Binding Stats.Uptime, Mode=OneWay}" FontWeight="Bold" Foreground="#CCCCCC"/>
                            </TextBlock>
                            <TextBlock Grid.Column="3" Foreground="#858585" FontSize="12" Margin="16,0">
                                <Run Text="Traffic:"/>
                                <Run Text="{Binding TotalTraffic, Mode=OneWay}" FontWeight="Bold" Foreground="#CCCCCC"/>
                            </TextBlock>
                            <TextBlock Grid.Column="4" Foreground="#858585" FontSize="12" Margin="16,0">
                                <Run Text="Rate:"/>
                                <Run Text="{Binding Stats.ConnectionRate, Mode=OneWay}" FontWeight="Bold" Foreground="#CCCCCC"/>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- ============================================
             STATUS BAR
             ============================================ -->
        <Border Grid.Row="2" Background="#007ACC" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TcpRedirector v1.0.0"
                           Foreground="White" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusText, Mode=OneWay}"
                           Foreground="White" FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>