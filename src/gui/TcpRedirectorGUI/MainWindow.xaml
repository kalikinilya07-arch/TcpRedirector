<Window x:Class="TcpRedirectorGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:vm="clr-namespace:TcpRedirectorGUI.Adapters.Driving.Wpf.ViewModels"
        xmlns:ctl="clr-namespace:TcpRedirectorGUI.Adapters.Driving.Wpf.Controls"
        xmlns:dom="clr-namespace:TcpRedirectorGUI.Domain.Entities"
        Title="TcpRedirector"
        Height="800" Width="1100" MinHeight="600" MinWidth="900"
        Background="#1E1E1E"
        FontFamily="Segoe UI"
        TextElement.Foreground="#CCCCCC"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- WP5: enum ItemsSource providers for CaptureMode / WintunEngineKind combos.
             The corresponding VM properties expose IReadOnlyList<T>; we use them
             through the DataContext, but keep these ObjectDataProviders around as
             a safety net so the ComboBox items appear even if the VM binding path
             changes. Not currently referenced from bindings — kept for future use. -->

        <!-- Red border + tooltip for TextBox with a validation error (WP5 port spec). -->
        <Style x:Key="PortSpecTextBox" TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#F44747"/>
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self},
                                            Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <!-- Service bar -->
            <RowDefinition Height="40"/>
            <!-- Content: vertically scrollable region — a scrollbar appears when
                 the settings (especially in Wintun mode) exceed the window height -->
            <RowDefinition Height="*"/>
            <!-- Status bar -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ============================================
             SERVICE CONTROL BAR
             ============================================ -->
        <Border Grid.Row="0" Background="#2D2D2D" BorderBrush="#3C3C3C"
                BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Start -->
                <Button Grid.Column="0" Content="{DynamicResource Btn.Start}"
                        Command="{Binding StartServiceCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="16,6" Margin="0,0,6,0"/>

                <!-- Stop -->
                <Button Grid.Column="1" Content="{DynamicResource Btn.Stop}"
                        Command="{Binding StopServiceCommand}"
                        Style="{StaticResource DangerButton}"
                        Padding="16,6" Margin="0,0,6,0"/>

                <!-- Status indicators -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Indicator 1: service status (unchanged semantics) -->
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding IsConnected, Converter={StaticResource BoolToColor}}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding SvcStatus, Mode=OneWay}"
                               Foreground="#CCCCCC" FontSize="12"
                               VerticalAlignment="Center"/>

                    <!-- Indicator 2 (Task 2): Kerberos auth component status.
                         Visible only when per-user Kerberos auth is enabled in
                         config (IsKerberosIndicatorVisible). The dot is green
                         when the component is healthy (active), red otherwise. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="14,0,0,0"
                                Visibility="{Binding IsKerberosIndicatorVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Auth.Kerberos.Label}"
                                   Foreground="#858585" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding IsKerberosHealthy, Converter={StaticResource BoolToColor}}"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding KerberosStatus, Mode=OneWay}"
                                   Foreground="#CCCCCC" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding SvcMsg, Mode=OneWay}"
                               Foreground="#4EC9B0" FontSize="12"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Language switcher (Задача №1) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource Bar.Language}"
                               Foreground="#858585" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="110" FontSize="12"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding Language, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource LangName}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Connection info -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Foreground="#858585">
                        <Run Text="{DynamicResource Bar.Traffic}"/>
                        <Run Text="{Binding TotalTraffic, Mode=OneWay}" FontWeight="Bold" Foreground="#CCCCCC"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================
             CONTENT: vertically scrollable region wrapping
             settings + statistics.  The ScrollViewer keeps every
             control reachable when the settings grow (e.g. when
             Wintun mode is selected) beyond the window height.
             Horizontal scrolling is disabled so content reflows to
             the viewport width; MaxWidth caps it on very wide screens.
             ============================================ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,2,0">
            <Grid MaxWidth="1400" Margin="10,0,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- SETTINGS (top 2/3) -->
                <StackPanel Grid.Row="0">

                    <!-- Proxy Settings -->
                    <TextBlock Text="{DynamicResource Section.Proxy}" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource SectionBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Proxy.Host}"
                                       VerticalAlignment="Center" Margin="0,2"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource ValidatedTextBox}"
                                     Text="{Binding Settings.Host, Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged,
                                                    ValidatesOnNotifyDataErrors=True,
                                                    NotifyOnValidationError=True}"
                                     Margin="0,2"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Proxy.Port}"
                                       VerticalAlignment="Center" Margin="8,2,0,2"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Style="{StaticResource ValidatedTextBox}"
                                     Text="{Binding Settings.Port, Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged,
                                                    ValidatesOnExceptions=True,
                                                    ValidatesOnNotifyDataErrors=True,
                                                    NotifyOnValidationError=True}"
                                     Margin="8,2,0,2"/>

                            <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                      Content="{DynamicResource Proxy.AuthRequired}"
                                      IsChecked="{Binding Settings.AuthRequired, Mode=TwoWay}"
                                      Margin="0,2"/>
                        </Grid>
                    </Border>

                    <!-- Authentication -->
                    <TextBlock Text="{DynamicResource Section.Auth}"
                               Style="{StaticResource SectionHeader}"
                               Visibility="{Binding Settings.AuthRequired, Converter={StaticResource BoolToVis}}"/>
                    <Border Style="{StaticResource SectionBorder}"
                            Visibility="{Binding Settings.AuthRequired, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- Kerberos toggle — всегда виден, пока авторизация
                                 включена, чтобы можно было вернуться к Basic. -->
                            <CheckBox Content="{DynamicResource Auth.UseKerberos}"
                                      IsChecked="{Binding Settings.KerberosEnabled, Mode=TwoWay}"
                                      Margin="0,2"/>

                            <!-- (Phase 9) Per-user Kerberos auth helper.
                                 Чекбокс «per-user» виден только при включённом
                                 Kerberos (SSPI). Под-поля (SPN, fallback-политика,
                                 таймаут) появляются, когда per-user включён. -->
                            <StackPanel Margin="0,6,0,0"
                                        Visibility="{Binding Settings.KerberosEnabled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource Auth.PerUserTitle}"
                                           Foreground="#DCDCAA" FontWeight="Bold"
                                           Margin="0,0,0,4"/>
                                <CheckBox Content="{DynamicResource Auth.PerUserEnabled}"
                                          IsChecked="{Binding Settings.PerUserEnabled, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Auth.PerUserEnabled.Tooltip}"
                                          Margin="0,2"/>

                                <!-- Per-user sub-fields — visible only when Kerberos
                                     AND per-user are enabled. -->
                                <Grid Margin="0,4,0,0"
                                      Visibility="{Binding Settings.ShowPerUserOptions, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- SPN override (empty = auto HTTP/<proxyhost>) -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{DynamicResource Auth.Spn}"
                                               VerticalAlignment="Center" Margin="0,2"/>
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Style="{StaticResource ValidatedTextBox}"
                                             Text="{Binding Settings.Spn, Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{DynamicResource Auth.Spn.Tooltip}"
                                             Margin="0,2"/>

                                    <!-- Helper timeout (ms) -->
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="{DynamicResource Auth.HelperTimeout}"
                                               VerticalAlignment="Center" Margin="8,2,0,2"/>
                                    <TextBox Grid.Row="0" Grid.Column="3"
                                             Style="{StaticResource ValidatedTextBox}"
                                             Text="{Binding Settings.HelperTimeoutMs, Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged,
                                                            ValidatesOnExceptions=True,
                                                            ValidatesOnNotifyDataErrors=True,
                                                            NotifyOnValidationError=True}"
                                             ToolTip="{DynamicResource Auth.HelperTimeout.Tooltip}"
                                             Margin="8,2,0,2"/>

                                    <!-- Fallback policy (drop/system/error) -->
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="{DynamicResource Auth.FallbackPolicy}"
                                               VerticalAlignment="Center" Margin="0,2"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding Settings.FallbackPolicies}"
                                              SelectedItem="{Binding Settings.FallbackPolicy, Mode=TwoWay}"
                                              ToolTip="{DynamicResource Auth.FallbackPolicy.Tooltip}"
                                              Margin="0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                                               TextWrapping="Wrap" Foreground="#DCDCAA"
                                               FontSize="11" Margin="0,4,0,0"
                                               Text="{DynamicResource Auth.FallbackPolicy.Note}"/>
                                </Grid>
                            </StackPanel>

                            <!-- (Задача №3) Поля Basic-аутентификации (Login,
                                 Password, «Шифровать пароль») скрываются при
                                 включённом Kerberos и снова показываются при его
                                 отключении. -->
                            <Grid Visibility="{Binding Settings.ShowBasicCredentials, Converter={StaticResource BoolToVis}}"
                                  Margin="0,2,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Auth.Login}"
                                           VerticalAlignment="Center" Margin="0,2"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Style="{StaticResource ValidatedTextBox}"
                                         Text="{Binding Settings.Login, Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged,
                                                        ValidatesOnNotifyDataErrors=True,
                                                        NotifyOnValidationError=True}"
                                         Margin="0,2"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Auth.Password}"
                                           VerticalAlignment="Center" Margin="8,2,0,2"/>
                                <!-- PasswordBox + overlay-плейсхолдер: если пароль уже
                                     сохранён (в любом формате), показываем «••••••••»,
                                     пока поле пустое; при вводе символов плейсхолдер
                                     скрывается. Само поле остаётся пустым до ввода. -->
                                <Grid Grid.Row="0" Grid.Column="3" Margin="8,2,0,2">
                                    <PasswordBox x:Name="PwdBox"/>
                                    <TextBlock x:Name="PwdPlaceholder"
                                               Text="{Binding Settings.PasswordPlaceholder}"
                                               Foreground="#7F7F7F"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               IsHitTestVisible="False"/>
                                </Grid>

                                <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                          Content="{DynamicResource Auth.EncryptPassword}"
                                          IsChecked="{Binding Settings.EncryptPassword, Mode=TwoWay}"
                                          Margin="0,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- WP5: Capture mode + Wintun settings -->
                    <TextBlock Text="{DynamicResource Section.CaptureMode}" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource SectionBorder}">
                        <StackPanel>
                            <!-- Mode selector -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{DynamicResource Capture.Mode}" VerticalAlignment="Center"
                                           Width="90" Margin="0,2"/>
                                <ComboBox Width="180"
                                          ItemsSource="{Binding Settings.CaptureModes}"
                                          SelectedItem="{Binding Settings.CaptureMode, Mode=TwoWay}"
                                          Margin="0,2"/>
                            </StackPanel>

                            <!-- WinDivert info block — visible only in WinDivert mode -->
                            <Border BorderBrush="#3C3C3C" BorderThickness="0,1,0,0"
                                    Margin="0,6,0,0" Padding="0,6,0,0"
                                    Visibility="{Binding Settings.IsWinDivertSelected, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Capture.WinDivertTitle}"
                                               Foreground="#DCDCAA" FontWeight="Bold"
                                               Margin="0,0,0,4"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#9CDCFE"
                                               Text="{DynamicResource Capture.WinDivertInfo}"/>
                                </StackPanel>
                            </Border>

                            <!-- Wintun sub-panel — visible only in Wintun mode -->
                            <Border BorderBrush="#3C3C3C" BorderThickness="0,1,0,0"
                                    Margin="0,6,0,0" Padding="0,6,0,0"
                                    Visibility="{Binding Settings.IsWintunSelected, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Capture.WintunTitle}"
                                               Foreground="#DCDCAA" FontWeight="Bold"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="250"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{DynamicResource Wintun.AdapterName}"
                                                   VerticalAlignment="Center" Margin="0,2"/>
                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                 Style="{StaticResource ValidatedTextBox}"
                                                 Text="{Binding Settings.WintunAdapterName, Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged,
                                                                ValidatesOnNotifyDataErrors=True,
                                                                NotifyOnValidationError=True}"
                                                 Margin="0,2"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                   Text="{DynamicResource Wintun.Mtu}"
                                                   VerticalAlignment="Center" Margin="8,2,0,2"/>
                                        <TextBox Grid.Row="0" Grid.Column="3"
                                                 Style="{StaticResource ValidatedTextBox}"
                                                 Text="{Binding Settings.WintunMtu, Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged,
                                                                ValidatesOnExceptions=True,
                                                                ValidatesOnNotifyDataErrors=True,
                                                                NotifyOnValidationError=True}"
                                                 Margin="8,2,0,2"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{DynamicResource Wintun.TunnelIpv4Cidr}"
                                                   VerticalAlignment="Center" Margin="0,2"/>
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Style="{StaticResource ValidatedTextBox}"
                                                 Text="{Binding Settings.WintunTunnelIpv4Cidr, Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged,
                                                                ValidatesOnNotifyDataErrors=True,
                                                                NotifyOnValidationError=True}"
                                                 Margin="0,2"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Text="{DynamicResource Wintun.Engine}"
                                                   VerticalAlignment="Center" Margin="0,2"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1"
                                                  ItemsSource="{Binding Settings.WintunEngines}"
                                                  SelectedItem="{Binding Settings.WintunEngine, Mode=TwoWay}"
                                                  Margin="0,2"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0"
                                                   Text="{DynamicResource Wintun.RouteLadderPrefix}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="0,2"/>
                                        <TextBox Grid.Row="3" Grid.Column="1"
                                                 Style="{StaticResource ValidatedTextBox}"
                                                 Text="{Binding Settings.WintunRouteLadderPrefix, Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged,
                                                                ValidatesOnExceptions=True,
                                                                ValidatesOnNotifyDataErrors=True,
                                                                NotifyOnValidationError=True}"
                                                 Margin="0,2"/>
                                    </Grid>

                                    <CheckBox Content="{DynamicResource Wintun.ProcessFilter}"
                                              IsChecked="{Binding Settings.WintunProcessFilterEnabled, Mode=TwoWay}"
                                              Margin="0,6,0,0"/>

                                    <CheckBox Content="{DynamicResource Wintun.BlockIpv6}"
                                              IsChecked="{Binding Settings.WintunBlockIpv6, Mode=TwoWay}"
                                              Margin="0,6,0,0"/>

                                    <!-- External engine sub-panel — visible only when engine==External -->
                                    <StackPanel Margin="0,6,0,0"
                                                Visibility="{Binding Settings.IsExternalEngine, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{DynamicResource Wintun.ExternalTitle}"
                                                   Foreground="#DCDCAA" FontWeight="Bold"
                                                   Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="{DynamicResource Wintun.ExternalExe}"
                                                       VerticalAlignment="Center" Margin="0,2"/>
                                            <TextBox Grid.Row="0" Grid.Column="1"
                                                     Style="{StaticResource ValidatedTextBox}"
                                                     Text="{Binding Settings.ExternalExecutable, Mode=TwoWay,
                                                                    UpdateSourceTrigger=PropertyChanged,
                                                                    ValidatesOnNotifyDataErrors=True,
                                                                    NotifyOnValidationError=True}"
                                                     Margin="0,2"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Text="{DynamicResource Wintun.ExternalSocks5}"
                                                       VerticalAlignment="Center" Margin="0,2"/>
                                            <TextBox Grid.Row="1" Grid.Column="1"
                                                     Style="{StaticResource ValidatedTextBox}"
                                                     Text="{Binding Settings.ExternalSocks5Listen, Mode=TwoWay,
                                                                    UpdateSourceTrigger=PropertyChanged,
                                                                    ValidatesOnNotifyDataErrors=True,
                                                                    NotifyOnValidationError=True}"
                                                     Margin="0,2"/>

                                            <CheckBox Grid.Row="2" Grid.Column="1"
                                                      Content="{DynamicResource Wintun.ExternalRestart}"
                                                      IsChecked="{Binding Settings.ExternalRestartOnCrash, Mode=TwoWay}"
                                                      Margin="0,2"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- WP5: Apps (multi-port per-app rules) -->
                    <TextBlock Text="{DynamicResource Section.Apps}" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource SectionBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="{DynamicResource Apps.Add}"
                                        Command="{Binding Settings.AddRuleCommand}"
                                        Padding="12,6" Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Apps.SaveAll}"
                                        Command="{Binding Settings.SaveAllCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="12,6"/>
                                <TextBlock Text="{DynamicResource Apps.Unsaved}"
                                           Foreground="#DCDCAA" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                           Visibility="{Binding Settings.IsDirty, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding Settings.Msg, Mode=OneWay}"
                                           Foreground="#4EC9B0" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Settings.Apps}"
                                      SelectedItem="{Binding Settings.SelectedApp}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      FontSize="12"
                                      MinHeight="60" MaxHeight="400">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Apps.Col.Pattern}"
                                                        Binding="{Binding Pattern}"
                                                        Width="180"/>
                                    <DataGridTextColumn Header="{DynamicResource Apps.Col.FullPath}"
                                                        Binding="{Binding ExePath}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource Apps.Col.ProxyId}"
                                                        Binding="{Binding ProxyId}"
                                                        Width="90"/>
                                    <DataGridCheckBoxColumn Header="{DynamicResource Apps.Col.RouteAll}"
                                                            Binding="{Binding RouteAllTraffic, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="90"/>
                                    <DataGridTemplateColumn Header="{DynamicResource Apps.Col.Ports}"
                                                            Width="260">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource PortSpecTextBox}"
                                                         Text="{Binding PortSpec, Mode=TwoWay,
                                                                        UpdateSourceTrigger=LostFocus,
                                                                        ValidatesOnNotifyDataErrors=True,
                                                                        NotifyOnValidationError=True}"
                                                         IsEnabled="{Binding PortsEditable}"
                                                         ToolTip="{DynamicResource Apps.Ports.Tooltip}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕"
                                                        Command="{Binding DataContext.Settings.DeleteAppCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#5A1D1D" Foreground="#F44747"
                                                        BorderThickness="0" FontSize="11"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="2" Foreground="#858585" Margin="0,4,0,0" FontSize="12">
                                <Run Text="{DynamicResource Apps.TotalPrefix}"/> <Run Text="{Binding Settings.Apps.Count, Mode=OneWay}" FontWeight="Bold"/> <Run Text="{DynamicResource Apps.TotalSuffix}"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Task 4: Packet / connection trace -->
                    <TextBlock Text="{DynamicResource Section.Trace}"
                               Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource SectionBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding Trace.Connections}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      FontSize="12"
                                      MinHeight="60" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Trace.Col.Process}"
                                                        Binding="{Binding ProcessName}" Width="150"/>
                                    <DataGridTextColumn Header="{DynamicResource Trace.Col.Pid}"
                                                        Binding="{Binding Pid}" Width="60"/>
                                    <DataGridTextColumn Header="{DynamicResource Trace.Col.Destination}"
                                                        Binding="{Binding DisplayDestination}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource Trace.Col.Port}"
                                                        Binding="{Binding DestinationPort}" Width="60"/>
                                    <DataGridTextColumn Header="{DynamicResource Trace.Col.State}"
                                                        Binding="{Binding State}" Width="120"/>
                                    <DataGridCheckBoxColumn Header="{DynamicResource Trace.Col.ViaProxy}"
                                                            Binding="{Binding ProxyEnabled}" Width="90"/>
                                    <DataGridTextColumn Header="{DynamicResource Trace.Col.Rx}"
                                                        Binding="{Binding RxDisplay}" Width="80"/>
                                    <DataGridTextColumn Header="{DynamicResource Trace.Col.Tx}"
                                                        Binding="{Binding TxDisplay}" Width="80"/>
                                    <DataGridTextColumn Header="{DynamicResource Trace.Col.Duration}"
                                                        Binding="{Binding DurationDisplay}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="1" Foreground="#858585" Margin="0,4,0,0" FontSize="12">
                                <Run Text="{DynamicResource Trace.ActivePrefix}"/> <Run Text="{Binding Trace.Count, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>

                            <TextBlock Grid.Row="2" Foreground="#DCDCAA" Margin="0,2,0,0" FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="{DynamicResource Trace.Note}"/>
                        </Grid>
                    </Border>

                    <!-- Дополнительно: IPC / безопасность -->
                    <TextBlock Text="{DynamicResource Section.Ipc}"
                               Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource SectionBorder}">
                        <StackPanel>
                            <CheckBox Content="{DynamicResource Ipc.AuthEnabled}"
                                      IsChecked="{Binding Settings.IpcAuthEnabled, Mode=TwoWay}"
                                      Margin="0,2"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#DCDCAA" FontSize="11"
                                       Margin="0,2,0,0"
                                       Text="{DynamicResource Ipc.Note}"/>
                        </StackPanel>
                    </Border>

                    <!-- Log Level -->
                    <TextBlock Text="{DynamicResource Section.LogLevel}" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource SectionBorder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Log.Level}" Foreground="#858585"
                                       FontSize="12" VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <ComboBox SelectedIndex="{Binding Settings.LogLevelFilter, Mode=TwoWay}"
                                      Width="90" FontSize="12">
                                <ComboBoxItem Content="All (TRACE+)"/>
                                <ComboBoxItem Content="DEBUG+"/>
                                <ComboBoxItem Content="INFO+"/>
                                <ComboBoxItem Content="WARN+"/>
                                <ComboBoxItem Content="ERROR+"/>
                            </ComboBox>
                            <Button Content="{DynamicResource Log.Save}"
                                    Command="{Binding Settings.SaveLogLevelCommand}"
                                    Padding="12,4" Margin="8,0,0,0"
                                    FontSize="12"/>
                            <TextBlock Text="{Binding Settings.LogMsg, Mode=OneWay}"
                                       Foreground="#4EC9B0" FontWeight="Bold"
                                       FontSize="12" VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- STATISTICS (bottom section).  Fixed height so the traffic
                     graph (a Height="*" row inside) still gets a concrete size
                     within the ScrollViewer's unbounded vertical space. -->
                <Grid Grid.Row="1" Background="#1E1E1E" Height="300">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Graph header -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource Stats.Title}" FontWeight="Bold"
                                       Foreground="#DCDCAA" FontSize="13"/>
                        </Grid>

                        <!-- The custom chart control -->
                        <ctl:TrafficGraph Grid.Row="1"
                                          RxData="{Binding Stats.RxPoints}"
                                          TxData="{Binding Stats.TxPoints}"
                                          WindowSeconds="{Binding Stats.GraphWindowSec}"/>

                        <!-- Stats summary row 1 -->
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="#858585" FontSize="12">
                                <Run Text="{DynamicResource Stats.ActiveConnections}"/>
                                <Run Text="{Binding Stats.ActiveConnections, Mode=OneWay}" FontWeight="Bold" Foreground="#CCCCCC"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Foreground="#858585" FontSize="12" Margin="16,0">
                                <Run Text="{DynamicResource Stats.Rx}"/>
                                <Run Text="{Binding Stats.TotalRx, Mode=OneWay}" FontWeight="Bold" Foreground="#4EC9B0"/>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Foreground="#858585" FontSize="12">
                                <Run Text="{DynamicResource Stats.Tx}"/>
                                <Run Text="{Binding Stats.TotalTx, Mode=OneWay}" FontWeight="Bold" Foreground="#CE9178"/>
                            </TextBlock>
                        </Grid>

                        <!-- Stats summary row 2: derived metrics -->
                        <Grid Grid.Row="3" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="#858585" FontSize="12">
                                <Run Text="{DynamicResource Stats.ProxyErrors}"/>
                                <Run Text="{Binding Stats.ProxyErrors, Mode=OneWay}" FontWeight="Bold" Foreground="#F44747"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Foreground="#858585" FontSize="12" Margin="16,0">
                                <Run Text="{DynamicResource Stats.AvgLatency}"/>
                                <Run Text="{Binding Stats.AvgLatency, Mode=OneWay}" FontWeight="Bold" Foreground="#CCCCCC"/>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Foreground="#858585" FontSize="12" Margin="16,0">
                                <Run Text="{DynamicResource Stats.Uptime}"/>
                                <Run Text="{Binding Stats.Uptime, Mode=OneWay}" FontWeight="Bold" Foreground="#CCCCCC"/>
                            </TextBlock>
                            <TextBlock Grid.Column="4" Foreground="#858585" FontSize="12" Margin="16,0">
                                <Run Text="{DynamicResource Stats.Rate}"/>
                                <Run Text="{Binding Stats.ConnectionRate, Mode=OneWay}" FontWeight="Bold" Foreground="#CCCCCC"/>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ============================================
             STATUS BAR
             ============================================ -->
        <Border Grid.Row="2" Background="#007ACC" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TcpRedirector v1.0.0"
                           Foreground="White" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusText, Mode=OneWay}"
                           Foreground="White" FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>