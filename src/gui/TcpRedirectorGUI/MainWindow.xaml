<Window x:Class="TcpRedirectorGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TcpRedirectorGUI.Adapters.Driving.Wpf.ViewModels"
        xmlns:ctl="clr-namespace:TcpRedirectorGUI.Adapters.Driving.Wpf.Controls"
        Title="TcpRedirector"
        Height="800" Width="1100" MinHeight="600" MinWidth="900"
        Background="#1E1E1E"
        FontFamily="Segoe UI"
        TextElement.Foreground="#CCCCCC"
        WindowStartupLocation="CenterScreen">


    <Grid>
        <Grid.RowDefinitions>
            <!-- Tab bar -->
            <RowDefinition Height="36"/>
            <!-- Service bar -->
            <RowDefinition Height="40"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Status bar -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ============================================
             TAB BAR (VSCode-style)
             ============================================ -->
        <Border Grid.Row="0" Background="#252526">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <TextBlock Grid.Column="0" Text="TcpRedirector"
                           Foreground="#007ACC" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="16,0,20,0"/>

                <!-- Tab: Settings -->
                <Button Grid.Column="1"
                        Content="Settings"
                        Command="{Binding NavCommand}"
                        CommandParameter="Settings"
                        Width="100">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Settings">
                                    <Setter Property="Background" Value="{StaticResource EditorBgBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Tab: Statistics -->
                <Button Grid.Column="2"
                        Content="Statistics"
                        Command="{Binding NavCommand}"
                        CommandParameter="Statistics"
                        Width="100">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Statistics">
                                    <Setter Property="Background" Value="{StaticResource EditorBgBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ============================================
             SERVICE CONTROL BAR
             ============================================ -->
        <Border Grid.Row="1" Background="#2D2D2D" BorderBrush="#3C3C3C"
                BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Start -->
                <Button Grid.Column="0" Content="Start"
                        Command="{Binding StartServiceCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="16,6" Margin="0,0,6,0"/>

                <!-- Stop -->
                <Button Grid.Column="1" Content="Stop"
                        Command="{Binding StopServiceCommand}"
                        Style="{StaticResource DangerButton}"
                        Padding="16,6" Margin="0,0,6,0"/>

                <!-- Status indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding IsConnected, Converter={StaticResource BoolToColor}}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding SvcStatus, Mode=OneWay}"
                               Foreground="#CCCCCC" FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SvcMsg, Mode=OneWay}"
                               Foreground="#4EC9B0" FontSize="12"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Connection info -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Foreground="#858585" Margin="0,0,16,0">
                        <Run Text="Conn:"/>
                        <Run Text="{Binding ActiveConnections, Mode=OneWay}" FontWeight="Bold" Foreground="#CCCCCC"/>
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="#858585">
                        <Run Text="Traffic:"/>
                        <Run Text="{Binding TotalTraffic, Mode=OneWay}" FontWeight="Bold" Foreground="#CCCCCC"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================
             CONTENT AREA
             ============================================ -->
        <Grid Grid.Row="2" Margin="0,0,0,0">

            <!-- ════════════════════════════════════════
                 TAB 1: SETTINGS
                 ════════════════════════════════════════ -->
            <ScrollViewer Visibility="{Binding ActiveTab, Converter={StaticResource ViewToVis}, ConverterParameter=Settings}"
                          Background="#1E1E1E"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,16">
                <StackPanel>

                    <!-- ── Proxy Settings ──────────────────── -->
                    <TextBlock Text="PROXY SETTINGS" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource SectionBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Host:"
                                       VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding Settings.Host, Mode=TwoWay}"
                                     Margin="0,4"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Port:"
                                       VerticalAlignment="Center" Margin="8,4,0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="3"
                                     Text="{Binding Settings.Port, Mode=TwoWay}"
                                     Margin="8,4,0,4"/>

                            <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                      Content="Authentication required"
                                      IsChecked="{Binding Settings.AuthRequired, Mode=TwoWay}"
                                      Margin="0,4"/>
                        </Grid>
                    </Border>

                    <!-- ── Authentication ──────────────────── -->
                    <TextBlock Text="AUTHENTICATION (Login / Kerberos SSPI)"
                               Style="{StaticResource SectionHeader}"
                               Visibility="{Binding Settings.AuthRequired, Converter={StaticResource BoolToVis}}"/>
                    <Border Style="{StaticResource SectionBorder}"
                            Visibility="{Binding Settings.AuthRequired, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Login:"
                                       VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding Settings.Login, Mode=TwoWay}"
                                     Margin="0,4"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Password:"
                                       VerticalAlignment="Center" Margin="8,4,0,4"/>
                            <PasswordBox Grid.Row="0" Grid.Column="3"
                                         x:Name="PwdBox" Margin="8,4,0,4"/>

                            <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                      Content="Use Kerberos protocol"
                                      IsChecked="{Binding Settings.KerberosEnabled, Mode=TwoWay}"
                                      Margin="0,4"/>
                        </Grid>
                    </Border>

                    <!-- ── Rules ───────────────────────────── -->
                    <TextBlock Text="RULES" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource SectionBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="200"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="+ Add Rule"
                                        Command="{Binding Settings.AddRuleCommand}"
                                        Padding="12,6" Margin="0,0,8,0"/>
                                <Button Content="Save"
                                        Command="{Binding Settings.SaveAsyncCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="12,6"/>
                                <TextBlock Text="{Binding Settings.Msg, Mode=OneWay}"
                                           Foreground="#4EC9B0" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Settings.Rules}"
                                      SelectedItem="{Binding Settings.SelectedRule}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}" Width="*"/>
                                    <DataGridTextColumn Header="App" Binding="{Binding Description}" Width="150"/>
                                    <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="60"/>
                                    <DataGridTemplateColumn Header="" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕"
                                                        Command="{Binding DataContext.Settings.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#5A1D1D" Foreground="#F44747"
                                                        BorderThickness="0" FontSize="11"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="2" Foreground="#858585" Margin="0,4,0,0" FontSize="12">
                                Total: <Run Text="{Binding Settings.Rules.Count, Mode=OneWay}" FontWeight="Bold"/> rules
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- ── Log Level ─────────────────────────── -->
                    <TextBlock Text="LOG LEVEL" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource SectionBorder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Level:" Foreground="#858585"
                                       FontSize="12" VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <ComboBox SelectedIndex="{Binding Settings.LogLevelFilter, Mode=TwoWay}"
                                      Width="90" FontSize="12">
                                <ComboBoxItem Content="All (TRACE+)"/>
                                <ComboBoxItem Content="DEBUG+"/>
                                <ComboBoxItem Content="INFO+"/>
                                <ComboBoxItem Content="WARN+"/>
                                <ComboBoxItem Content="ERROR+"/>
                            </ComboBox>
                            <Button Content="Save"
                                    Command="{Binding Settings.SaveLogLevelCommand}"
                                    Padding="12,4" Margin="8,0,0,0"
                                    FontSize="12"/>
                            <TextBlock Text="{Binding Settings.LogMsg, Mode=OneWay}"
                                       Foreground="#4EC9B0" FontWeight="Bold"
                                       FontSize="12" VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ════════════════════════════════════════
                 TAB 2: STATISTICS
                 ════════════════════════════════════════ -->
            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource ViewToVis}, ConverterParameter=Statistics}"
                  Background="#1E1E1E">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Graph header -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="TRAFFIC (bytes/sec)" FontWeight="Bold"
                                   Foreground="#DCDCAA" FontSize="13"/>
                    </Grid>

                    <!-- The custom chart control -->
                    <ctl:TrafficGraph Grid.Row="1"
                                      RxData="{Binding Stats.RxPoints}"
                                      TxData="{Binding Stats.TxPoints}"/>

                    <!-- Stats summary -->
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="#858585" FontSize="12">
                            <Run Text="Total connections:"/>
                            <Run Text="{Binding Stats.TotalConnections, Mode=OneWay}" FontWeight="Bold" Foreground="#CCCCCC"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Foreground="#858585" FontSize="12" Margin="16,0">
                            <Run Text="RX:"/>
                            <Run Text="{Binding Stats.TotalRx, Mode=OneWay}" FontWeight="Bold" Foreground="#4EC9B0"/>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Foreground="#858585" FontSize="12">
                            <Run Text="TX:"/>
                            <Run Text="{Binding Stats.TotalTx, Mode=OneWay}" FontWeight="Bold" Foreground="#CE9178"/>
                        </TextBlock>
                        <TextBlock Grid.Column="3" Foreground="#858585" FontSize="12" Margin="16,0">
                            <Run Text="Active:"/>
                            <Run Text="{Binding Stats.ActiveConnections, Mode=OneWay}" FontWeight="Bold" Foreground="#CCCCCC"/>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================
             STATUS BAR
             ============================================ -->
        <Border Grid.Row="3" Background="#007ACC" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TcpRedirector v1.0.0"
                           Foreground="White" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusText, Mode=OneWay}"
                           Foreground="White" FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>