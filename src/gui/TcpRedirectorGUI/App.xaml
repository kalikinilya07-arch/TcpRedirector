<Application x:Class="TcpRedirectorGUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TcpRedirectorGUI">
    <Application.Resources>
        <ResourceDictionary>
            <local:ViewToVisConverter x:Key="ViewToVis" />
            <local:BoolToColorConverter x:Key="BoolToColor" />
            <local:BoolToVisConverter x:Key="BoolToVis" />
            <local:LanguageNameConverter x:Key="LangName" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Adapters/Driving/Wpf/Styles/AppTheme.xaml" />
                <!-- (Задача №1) Дефолтный словарь строк (RU). При старте
                     LocalizationService заменяет его на выбранный язык. -->
                <ResourceDictionary Source="Adapters/Driving/Wpf/Localization/Strings.ru.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>