<?xml version="1.0" encoding="utf-8"?>
<!--
  TcpRedirectorAuthHelper.vcxproj  (Variant 4b, Phase 3)

  Per-user Kerberos auth helper. Крошечный headless-EXE, запускаемый службой
  (Phase 5) внутри логон-сессии пользователя. Держит named-pipe СЕРВЕР и
  выполняет SSPI/Negotiate в контексте пользователя.

  КЛЮЧЕВОЕ: линкует ОБЩИЙ auth_sspi.cpp из проекта службы БЕЗ КОПИИ
  (см. план §4.2). Никаких зависимостей WinDivert/wintun/lwIP.

  Подсистема: Console (headless; CREATE_NO_WINDOW при запуске службой не даст
  окну появиться). Платформа: x64 Release (как у службы).
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{C9F5A3B2-4D6E-4F71-9B8C-0D1E2F3A4B5C}</ProjectGuid>
    <RootNamespace>TcpRedirectorAuthHelper</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <LinkIncremental>false</LinkIncremental>
    <OutDir>$(SolutionDir)build\authhelper\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\authhelper\$(Platform)\$(Configuration)\obj\</IntDir>
    <TargetName>TcpRedirectorAuthHelper</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;SECURITY_WIN32;WIN32;_WINDOWS;NDEBUG;_CONSOLE;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!--
        external => nlohmann/json.hpp (используется AuthBrokerProtocol.h).
        Каталог проекта службы нужен, чтобы auth_sspi.cpp находил свой auth_sspi.h
        и чтобы относительные include в helper-файлах резолвились.
      -->
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..\..\..\external;$(ProjectDir)..\TcpRedirectorService</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>kernel32.lib;advapi32.lib;secur32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="AuthHelperMain.cpp" />
    <!-- ОБЩИЙ SSPI-модуль: линкуется ВЕРБАТИМ из проекта службы, без копии
         (план §4.2). Тот же файл параллельно компилируется в службу. -->
    <ClCompile Include="..\TcpRedirectorService\infrastructure\auth\auth_sspi.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="AuthPipeServer.h" />
    <ClInclude Include="HelperLog.h" />
    <ClInclude Include="..\TcpRedirectorService\infrastructure\auth\auth_sspi.h" />
    <ClInclude Include="..\..\shared\auth_broker\AuthBrokerProtocol.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
