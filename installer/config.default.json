{
    "config_version": 2,
    "capture_mode": "wintun",

    "app": {
        "exePath": ""
    },

    "proxy": {
        "host": "127.0.0.1",
        "port": 8888,
        "enabled": true
    },

    "auth": {
        "enabled": false,
        "kerberos": false,
        "username": "",
        "encryptedPassword": "",
        "per_user_enabled": false,
        "spn": "",
        "fallback_policy": "drop",
        "helper_timeout_ms": 5000
    },

    "log": {
        "level": 2,
        "fileEnabled": true,
        "maxSizeMB": 50
    },

    "stats": {
        "updateIntervalMs": 2000
    },

    "wintun": {
        "adapter_name": "TcpRedirector",
        "adapter_guid": "",
        "tunnel_ipv4_cidr": "10.6.7.1/24",
        "tunnel_ipv6_cidr": "",
        "mtu": 1500,
        "engine": "embedded",
        "process_filter_enabled": true,
        "block_ipv6": true,
        "direct_passthrough": false,
        "direct_fallback": "drop",
        "direct_egress_interface": "",
        "direct_route_optimization": true,
        "external_engine": {
            "executable": ".bin/tun2socks/tun2socks.exe",
            "extra_args": [],
            "socks5_listen": "127.0.0.1:1080",
            "restart_on_crash": true,
            "restart_backoff_ms": 2000
        }
    },

    "apps": [
        {
            "pattern": "TransfersClient.exe",
            "proxy_id": "default",
            "route_all_traffic": false,
            "ports": [443],
            "port_ranges": []
        }
    ],

    "rules": []
}
